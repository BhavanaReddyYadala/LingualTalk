<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background color -->
    <solid android:color="#FFFFFF" />

    <!-- Rounded corners -->
    <corners android:radius="24dp" />

    <!-- Subtle border -->
    <stroke
        android:width="1dp"
        android:color="#EAEAEA" />

    <!-- Padding inside card (optional but nice) -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />

</shape>